# Firebase Configuration
# Obtener estos valores desde Firebase Console > Project Settings > Your apps > Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Instrucciones:
# 1. Crea un proyecto en Firebase Console (https://console.firebase.google.com/)
# 2. Habilita Authentication con Email/Password y Google
# 3. Crea una base de datos Firestore
# 4. Habilita Storage para subir imagenes
# 5. Copia los valores de configuracion de tu app web
# 6. Renombra este archivo a .env.local y reemplaza los valores
